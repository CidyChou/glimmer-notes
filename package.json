{
  "name": "idea-space-taro",
  "version": "0.1.0",
  "private": true,
  "description": "Idea Space - Taro + React + TypeScript + Canvas 2D 微信小程序优先原型",
  "scripts": {
    "dev:weapp": "taro build --type weapp --watch",
    "build:weapp": "taro build --type weapp",
    "dev:h5": "taro build --type h5 --watch",
    "build:h5": "taro build --type h5",
    "dev:tt": "taro build --type tt --watch",
    "build:tt": "taro build --type tt",
    "typecheck": "tsc --noEmit",
    "test:backend": "node --test backend/test/*.test.mjs",
    "test:history": "tsx --test src/services/historyStack.test.ts"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 6",
    "iOS >= 12"
  ],
  "dependencies": {
    "@babel/runtime": "^7.24.4",
    "@tarojs/components": "4.2.1",
    "@tarojs/helper": "4.2.1",
    "@tarojs/plugin-framework-react": "4.2.1",
    "@tarojs/plugin-platform-h5": "4.2.1",
    "@tarojs/plugin-platform-tt": "4.2.1",
    "@tarojs/plugin-platform-weapp": "4.2.1",
    "@tarojs/react": "4.2.1",
    "@tarojs/runtime": "4.2.1",
    "@tarojs/shared": "4.2.1",
    "@tarojs/taro": "4.2.1",
    "@tarojs/taro-h5": "4.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@babel/preset-react": "^7.29.7",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.11",
    "@tarojs/cli": "4.2.1",
    "@tarojs/webpack5-runner": "4.2.1",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@types/webpack-env": "^1.18.5",
    "babel-preset-taro": "4.2.1",
    "react-refresh": "^0.14.2",
    "tsx": "^4.23.12",
    "typescript": "~5.4.5"
  },
  "allowScripts": {
    "@swc/core@1.3.96": true,
    "@tarojs/binding@4.2.1": true,
    "@tarojs/cli@4.2.1": true,
    "esbuild@0.21.5": true,
    "esbuild@0.28.2": true,
    "@parcel/watcher@2.6.0": true,
    "core-js@3.50.0": true,
    "core-js-pure@3.50.0": true
  }
}
